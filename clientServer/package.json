{
  "name": "apex-client",
  "version": "2.0.0",
  "description": "Local bridge for ApexTunnel, proxying local traffic to the public internet.",
  "main": "dist/bundle.cjs",
  "type": "module",
  "bin": {
    "apex": "./dist/bundle.cjs"
  },
  "scripts": {
    "start": "node client.js",
    "dev": "nodemon client.js",
    "bundle": "mkdir -p dist && esbuild client.js --bundle --platform=node --outfile=dist/bundle.cjs --format=cjs --external:blessed",
    "build": "pnpm run bundle && pkg . --out-path bin/",
    "build:all": "pnpm run bundle && pkg . --targets node18-linux-x64,node18-macos-x64,node18-win-x64,node18-linux-arm64 --out-path bin/"
  },
  "author": "BraveraTech",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "pkg": {
    "assets": [
      "node_modules/blessed/**/*"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1"
  },
  "dependencies": {
    "blessed": "^0.1.81"
  }
}
