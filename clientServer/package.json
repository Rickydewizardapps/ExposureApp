{
  "name": "apex-client",
  "version": "1.1.3",
  "description": "Local bridge for ApexTunnel, proxying local traffic to the public internet.",
  "main": "client.js",
  "type": "module",
  "bin": {
    "apex": "./launcher.cjs"
  },
  "scripts": {
    "start": "node client.js",
    "dev": "nodemon client.js",
    "build": "pkg . --output bin/apex"
  },
  "keywords": [
    "tunnel",
    "reverse-proxy",
    "localhost",
    "developer-tools"
  ],
  "author": "BraveraTech",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "pkg": {
    "assets": [
      "src/**/*",
      "client.js"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64",
      "node18-linux-arm64"
    ]
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "dotenv": "^17.4.0"
  }
}
